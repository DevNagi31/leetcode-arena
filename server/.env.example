# Required
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=your-secret-key-here
MONGODB_URI=mongodb://localhost:27017/code-manager

# Optional
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed browser origins (also gates the Socket.io
# handshake). Defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# Email (SMTP) - required in production to deliver email-verification and
# password-reset codes. If unset, messages are printed to the server console
# instead, which is fine for development but blocks signup in production
# (new accounts can never verify their email).
#
# Send through the provider that owns the From address, or the mail will fail
# SPF/DKIM alignment and be treated as spam. For a gmail.com address that means
# Gmail's own servers - routing it through a third party such as Brevo means
# sending from an IP gmail.com does not authorise.
#
# EMAIL_FROM is REQUIRED and, with Gmail, must equal SMTP_USER. Without it the
# server falls back to a non-existent domain and every send is rejected while
# the connection still looks healthy.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=you@gmail.com
