# Required
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=your-secret-key-here
MONGODB_URI=mongodb://localhost:27017/code-manager

# Optional
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed browser origins (also gates the Socket.io
# handshake). Defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# Email (SMTP) - required in production to deliver email-verification and
# password-reset codes. If unset, messages are printed to the server console
# instead, which is fine for development but blocks signup in production
# (new accounts can never verify their email).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com
