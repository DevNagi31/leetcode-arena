{
  "name": "code-manager",
  "version": "1.0.0",
  "description": "Code Manager - Developer Growth Platform",
  "main": "server/server.js",
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "build": "react-scripts build",
    "render-build": "npm install && cd server && npm install && cd .. && npm run build",
    "render-start": "NODE_ENV=production node server/server.js",
    "production": "npm run build && NODE_ENV=production node server/server.js",
    "test": "react-scripts test"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dompurify": "^3.3.3",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^8.2.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|lucide-react|socket.io-client)/)"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5001"
}
